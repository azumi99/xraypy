# cv-service environment — copy to .env and adjust
# Database (pgvector). Only used when dedup.store=pgvector.
CV_DATABASE_URL=postgresql://ilhambintang@localhost:5432/object_cv

# Optional PostgreSQL SSH tunnel; requires trusted SSH known_hosts and ssh.
# When enabled, set CV_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:15432/DBNAME
# Startup fails if the forward cannot be established. Default authentication uses SSH keys.
# CV_DB_TUNNEL_ENABLED=false
# CV_DB_TUNNEL_SSH_HOST=ssh.example.com
# CV_DB_TUNNEL_SSH_PORT=22
# CV_DB_TUNNEL_SSH_USER=ssh-user
# CV_DB_TUNNEL_SSH_KEY=/absolute/path/to/private_key
# CV_DB_TUNNEL_SSH_PASSWORD=replace-me
# Password authentication additionally requires sshpass; omit the password for keys.
# An explicit existing key uses IdentitiesOnly and BatchMode, disabling password prompts.

# Required: generate a random signing key with at least 32 bytes of entropy.
# CV_JWT_SECRET=replace-with-a-long-random-secret
# Required on startup; used only to insert missing initial users, never resets them.
# Set to admin123 for the requested initial accounts, then change their passwords.
# CV_BOOTSTRAP_PASSWORD=admin123

# Optional initial passwords for bc-bgd@paratekno.com and bc-cas@paratekno.com.
# CV_BC_BGD_PASSWORD=
# CV_BC_CAS_PASSWORD=
# CV_LABEL_PRINT_BGD_PASSWORD=
# CV_LABEL_PRINT_CAS_PASSWORD=

# Optional Cloudflare Turnstile for the web login form. Set both keys together.
# CV_TURNSTILE_SITE_KEY=
# CV_TURNSTILE_SECRET_KEY=

# Photo synchronization is disabled until credentials and VM receiver are provisioned.
# CV_PHOTO_SYNC_ENABLED=false
# CV_PHOTO_SYNC_URL=https://example.com
# CV_PHOTO_SYNC_OUTBOX_PATH=data/photo-sync-outbox.sqlite3
# CV_PHOTO_SYNC_BGD_TOKEN=<device-specific-bgd-token>
# CV_PHOTO_SYNC_CAS_TOKEN=<device-specific-cas-token>
# Receiver only: JSON map of independently revocable device tokens, e.g.
# CV_PHOTO_SYNC_DEVICES_JSON='{"device-bgd":{"site":"bgd","token":"replace-with-at-least-32-random-characters"}}'

# Assign physical camera indices to one warehouse only (comma-separated).
# CV_WAREHOUSE_BGD_CAMERAS=0
# CV_WAREHOUSE_CAS_CAMERAS=1

# Optional read-only MySQL manifest connections, configured separately per warehouse.
# MANIFEST_CAS_DB_HOST=localhost
# MANIFEST_CAS_DB_PORT=3306
# MANIFEST_CAS_DB_NAME=
# MANIFEST_CAS_DB_USER=
# MANIFEST_CAS_DB_PASSWORD=
# MANIFEST_BGD_DB_READONLY_HOST=localhost
# MANIFEST_BGD_DB_PORT=3306
# MANIFEST_BGD_DB_NAME=
# MANIFEST_BGD_DB_USER=
# MANIFEST_BGD_DB_PASSWORD=
# MANIFEST_CONNECT_TIMEOUT=5

# Optional lifespan-owned SSH tunnel. Requires sshpass, ssh and a pre-trusted
# SSH host key in known_hosts; unknown/changed keys are refused, never enrolled.
# Existing listeners are left untouched. Failures do not prevent backend startup.
# Environment variables override .env; passwords are passed only via SSHPASS.
MANIFEST_BGD_TUNNEL_ENABLED=false
# MANIFEST_BGD_TUNNEL_REMOTE_HOST=192.0.2.10
# MANIFEST_BGD_TUNNEL_REMOTE_PORT=3306
# MANIFEST_BGD_SSH_HOST=
# MANIFEST_BGD_SSH_PORT=23022
# MANIFEST_BGD_SSH_USER=
# MANIFEST_BGD_SSH_PASSWORD=
# Set MANIFEST_BGD_DB_READONLY_HOST=127.0.0.1 and MANIFEST_BGD_DB_PORT=13307.
# CAS is independently opt-in. Supply its verified target and DB_HOST/PORT;
# no CAS read-only endpoint is assumed. Same SSH_* and TUNNEL_REMOTE_* keys.
MANIFEST_CAS_TUNNEL_ENABLED=false

# Video source: synthetic (dev) | device (HDMI capture card index) | file
CV_CAPTURE__SOURCE_KIND=synthetic
# CV_CAPTURE__SOURCE_KIND=device
# CV_CAPTURE__SOURCE=0

# Pipeline mode: strip (scrolling HiTraX screen, default) | track (YOLO/MOG2 alt.)
CV_PIPELINE_MODE=strip
# Track mode only: full width, vertical fractions of each source frame.
# Start must be less than end; the end row is exclusive.
# CV_TRACK_ROI__TOP_START=0.03
# CV_TRACK_ROI__TOP_END=0.86
# CV_TRACK_ROI__SIDE_START=0.25
# CV_TRACK_ROI__SIDE_END=0.88
# Optional track preview: full-size PNGs of the empty conveyor, one per view.
# CV_DETECTOR__REFERENCE_TOP=/path/to/empty-top.png
# CV_DETECTOR__REFERENCE_SIDE=/path/to/empty-side.png
# CV_DETECTOR__REFERENCE_WEAK_DELTA=6
# CV_DETECTOR__REFERENCE_STRONG_DELTA=18
# Side track only: opt in to fragment merging with the same empty-side reference.
# CV_DETECTOR__SIDE_REFERENCE_MERGE=true
# CV_DETECTOR__TOP_REFERENCE_MERGE=true
# Optional detector viewport bottom is relative to the cropped track ROI.
# CV_DETECTOR__VIEWPORT_BOTTOM=1.0
# Opt-in track merge logs: up to 20 pairs per view per tracker every 5 seconds.
# CV_DETECTOR__MERGE_DIAGNOSTICS=true

# Embedding model: dinov2_small (default) | dinov2_base | resnet18 | resnet50
CV_EMBEDDING__MODEL=dinov2_small
CV_EMBEDDING__DEVICE=cpu

# Dedup thresholds — PROVISIONAL, calibrate with tools/calibrate_threshold.py
CV_DEDUP__T_HIGH=0.92
CV_DEDUP__T_LOW=0.80
CV_DEDUP__SCOPE=batch

# Global user management administrator
# CV_ADMIN_EMAIL=
# CV_ADMIN_PASSWORD=
